{
  "contract_version": "draft-1",
  "status": "proposed; not implemented",
  "description": "Local tool definitions. Each inputSchema/outputSchema is standalone JSON Schema; semantic constraints in mcp-tools.md also apply. Hosted tools are discovered separately.",
  "tools": [
    {
      "name": "list_products",
      "description": "Read shop products. Optional exact SKU and text search; results are paginated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "sku": {
                  "type": "string",
                  "maxLength": 100
                },
                "price": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})?$"
                },
                "regular_price": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})?$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "status": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "permalink": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "name",
                "sku",
                "price",
                "regular_price",
                "currency",
                "status",
                "permalink"
              ],
              "additionalProperties": false
            },
            "maxItems": 50
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "has_more": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "page",
          "per_page",
          "has_more"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
